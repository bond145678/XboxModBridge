<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XboxModBridge</AssemblyName>
    <RootNamespace>XboxModBridge</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Xbox Mod Bridge</Product>
    <Description>Lets the CurseForge app install mods into Xbox app / Game Pass PC games.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="fixpacks.json" LogicalName="fixpacks.json" />
  </ItemGroup>

</Project>
